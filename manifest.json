{
  "manifest_version": 3,
  "name": "Tabyss — Know Your Scroll",
  "version": "1.5.0",
  "description": "Plan focus sessions, understand browsing time, spot doomscrolling, and protect wellbeing — private and 100% on-device.",
  "minimum_chrome_version": "111",
  "permissions": ["tabs", "storage", "idle", "alarms", "notifications", "favicon"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabyss",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
