{
  "manifest_version": 3,
  "name": "Tabyss — Know Your Scroll",
  "version": "2.4.0",
  "description": "Understand your browsing, use an optional timer, and save pages for later — private and on-device.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "notifications"
  ],
  "background": {
    "scripts": [
      "common.js",
      "product.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabyss",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Tabyss Saved Pages",
    "default_icon": "icon48.png",
    "open_at_install": false
  },
  "commands": {
    "open-command-center": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open Tabyss Saved Pages"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabyss-addon@know-your-scroll.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
